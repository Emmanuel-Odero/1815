# Production Frontend Environment Variables

# Backend API URL - Set this to your actual backend API URL on Render
# Example: https://your-backend-service.onrender.com/api/v1
VITE_API_BASE_URL=https://one815-api.onrender.com/api/v1

# Application Configuration
VITE_APP_NAME=CardanoResolve
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# External Services
VITE_CARDANO_NETWORK=preprod

# Application URLs
VITE_APP_BASE_URL=https://one815.onrender.com
